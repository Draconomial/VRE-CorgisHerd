<?xml version="1.0" encoding="utf-8"?>
<Patch>
  <!-- StrayDogs: optional species, each checked individually.
       Only adds VRE_Herd eligibility; does not grant training. -->
  <Operation Class="PatchOperationConditional">
    <xpath>/Defs/ThingDef[defName="SCBorderCollie"]/race[not(trainableTags)]</xpath>
    <success>Always</success>
    <match Class="PatchOperationAdd">
      <xpath>/Defs/ThingDef[defName="SCBorderCollie"]/race[not(trainableTags)]</xpath>
      <value><trainableTags><li>VRE_Herd</li></trainableTags></value>
    </match>
  </Operation>
  <Operation Class="PatchOperationConditional">
    <xpath>/Defs/ThingDef[defName="SCBorderCollie"]/race/trainableTags[not(li="VRE_Herd")]</xpath>
