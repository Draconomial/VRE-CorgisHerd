<?xml version="1.0" encoding="utf-8"?>
<Patch>
  <!-- Vanilla Genetics Expanded / GeneticRim: selectively include Dogman and Mechawolf.
       This changes training eligibility, not learned training. -->
  <Operation Class="PatchOperationConditional">
    <xpath>/Defs/ThingDef[defName="GR_Dogman"]/race[not(trainableTags)]</xpath>
    <success>Always</success>
    <match Class="PatchOperationAdd">
      <xpath>/Defs/ThingDef[defName="GR_Dogman"]/race[not(trainableTags)]</xpath>
      <value><trainableTags><li>VRE_Herd</li></trainableTags></value>
    </match>
  </Operation>
  <Operation Class="PatchOperationConditional">
    <xpath>/Defs/ThingDef[defName="GR_Dogman"]/race/trainableTags[not(li="VRE_Herd")]</xpath>
    <success>Always</success>
    <match Class="PatchOperationAdd">
      <xpath>/Defs/ThingDef[defName="GR_Dogman"]/race/trainableTags[not(li="VRE_Herd")]</xpath>
      <value><li>VRE_Herd</li></value>
    </match>
  </Operation>
  <Operation Class="PatchOperationConditional">
    <xpath>/Defs/ThingDef[defName="GR_Mechawolf"]/race[not(trainableTags)]</xpath>
    <success>Always</success>
    <match Class="PatchOperationAdd">
      <xpath>/Defs/ThingDef[defName="GR_Mechawolf"]/race[not(trainableTags)]</xpath>
      <value><trainableTags><li>VRE_Herd</li></trainableTags></value>
    </match>
  </Operation>
  <Operation Class="PatchOperationConditional">
    <xpath>/Defs/ThingDef[defName="GR_Mechawolf"]/race/trainableTags[not(li="VRE_Herd")]</xpath>
    <success>Always</success>
    <match Class="PatchOperationAdd">
      <xpath>/Defs/ThingDef[defName="GR_Mechawolf"]/race/trainableTags[not(li="VRE_Herd")]</xpath>
      <value><li>VRE_Herd</li></value>
    </match>
  </Operation>
</Patch>
